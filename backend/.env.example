# --- Core ---
APP_NAME=BudgetFlow
ENVIRONMENT=development
# Local dev defaults to SQLite (no external service needed).
# Production (Render) example:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/budgetflow
DATABASE_URL=sqlite+aiosqlite:///./budgetflow.db

# --- Auth / JWT ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Rate limiting (per-IP, applied to sensitive auth routes) ---
AUTH_RATE_LIMIT=5/minute

# --- AI providers (free tiers first). Leave blank to mark a provider unconfigured. ---
DEFAULT_AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

HF_API_KEY=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# --- CORS (comma-separated origins; JSON array also accepted) ---
CORS_ORIGINS=["http://localhost:5173"]
